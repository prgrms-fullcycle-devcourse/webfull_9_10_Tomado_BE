# Copy this file to `env/local.env` (or export variables in your shell) before running locally.
COMPOSE_PROJECT_NAME=tomado

# App
PORT=4000
NODE_ENV=development

# Database (Supabase Postgres / local Postgres)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://tomado:tomado_password@localhost:5432/tomado?schema=public

# Postgres
POSTGRES_DB=tomado
POSTGRES_USER=tomado
POSTGRES_PASSWORD=tomado_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Optional: expose Adminer (DB UI)
ADMINER_PORT=8080

